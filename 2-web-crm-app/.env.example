# Skopiuj ten plik jako ".env" i uzupełnij danymi z Supabase
# (Supabase → przycisk "Connect" lub Project Settings → API Keys).
#
# Jeśli zostawisz te pola puste, aplikacja uruchomi się w TRYBIE DEMO
# (dane przykładowe zapisywane tylko w Twojej przeglądarce).

VITE_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=TWOJ_KLUCZ_PUBLISHABLE_LUB_ANON

# Nazwa wyświetlana w aplikacji
VITE_APP_NAME=Lead CRM

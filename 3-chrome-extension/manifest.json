{
  "manifest_version": 3,
  "name": "Lead Scanner – Mapy Google → CRM",
  "short_name": "Lead Scanner",
  "version": "1.0.0",
  "description": "Skanuje wyniki w Mapach Google, wyróżnia firmy bez strony WWW, ostrzega o duplikatach i wysyła leady do CRM (Supabase).",
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.pl/maps*",
        "https://maps.google.com/*",
        "https://maps.google.pl/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Lead Scanner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
